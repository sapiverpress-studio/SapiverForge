        "text": "* **Important Caveats:** This transaction represents the \"first close\" of the Series D round, with additional capital allocations expected in subsequent closes"
      },
      "groundingChunkIndices": [
        14,
        17
      ]
    },
    {
      "segment": {
        "startIndex": 4206,
        "endIndex": 4616,
