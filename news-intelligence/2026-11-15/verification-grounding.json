    },
    {
      "segment": {
        "startIndex": 7511,
        "endIndex": 7599,
        "text": "Project Zero is replacing its historical \"90+30\" policy with a strict \"Full X\" framework"
      },
      "groundingChunkIndices": [
        19,
        20
      ]
    },
    {
      "segment": {
        "startIndex": 7601,
        "endIndex": 7715,
        "text": "Effective immediately, vulnerabilities will be disclosed 90 days post-report with zero grace period or \"soak time\""
      },
      "groundingChunkIndices": [
