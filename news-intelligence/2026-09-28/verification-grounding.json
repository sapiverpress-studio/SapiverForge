      "groundingChunkIndices": [
        5,
        8
      ]
    },
    {
      "segment": {
        "startIndex": 2345,
        "endIndex": 2437,
        "text": "Flight controllers evaluated telemetry and proceeded with a 19-second orbital insertion burn"
      },
      "groundingChunkIndices": [
        5
