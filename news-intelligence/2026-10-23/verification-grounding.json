  "groundingSupports": [
    {
      "segment": {
        "startIndex": 227,
        "endIndex": 388,
        "text": "**What is confirmed:** *Financial Times* reports that Anthropic has agreed to launch an independent AI consultancy backed by London-based private equity group Hg"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 390,
        "endIndex": 463,
        "text": "Expected to launch by the end of 2026 with main hubs in London and Berlin"
      },
      "groundingChunkIndices": [
        1,
        2
      ]
    },
    {
      "segment": {
        "startIndex": 390,
        "endIndex": 610,
        "text": "Expected to launch by the end of 2026 with main hubs in London and Berlin, the firm will embed AI consultants and engineers into European businesses and Hg portfolio companies to build products and deploy model workflows"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 612,
        "endIndex": 696,
        "text": "Anthropic is providing balance-sheet capital alongside capital from Hg-managed funds"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 700,
        "endIndex": 765,
