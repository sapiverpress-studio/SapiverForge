    },
    {
      "segment": {
        "startIndex": 5172,
        "endIndex": 5373,
        "text": "* **Caveats:** The opt-out setting applies strictly to visual data; audio interactions with Meta AI remain stored for training/review unless users manually delete them or disable voice trigger settings"
      },
      "groundingChunkIndices": [
