  "groundingSupports": [
    {
      "segment": {
        "startIndex": 272,
        "endIndex": 324,
        "text": "**Publisher / Source:** Financial Times (2026-11-22)"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 327,
        "endIndex": 529,
        "text": "**Confirmed:** Major AI server vendors—including Dell, HPE, Lenovo, and Supermicro—are demanding price increases between 25% and 45% on AI hardware orders months after contracts were formally signed"
      },
      "groundingChunkIndices": [
        0,
        2,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 531,
        "endIndex": 646,
        "text": "The hikes are driven by skyrocketing memory component costs (DRAM and HBM prices are up over 400% since early 2024)"
      },
      "groundingChunkIndices": [
        4,
        2,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 648,
        "endIndex": 822,
        "text": "FT verified an active lawsuit in Irish court where British trading firm XTX Markets is suing Dell over a demanded $62M–$70M price increase on a previously fixed $549M order"
      },
      "groundingChunkIndices": [
        4,
        2,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 824,
        "endIndex": 926,
        "text": "HPE has also formally updated its quoting terms to reserve explicit repricing rights prior to shipment"
      },
      "groundingChunkIndices": [
        1,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 1047,
        "endIndex": 1142,
        "text": "Dell and Lenovo did not respond to requests for comment; HPE and Supermicro declined to comment"
