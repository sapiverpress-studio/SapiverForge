      ]
    },
    {
      "segment": {
        "startIndex": 1150,
        "endIndex": 1416,
        "text": "**What is confirmed:** The *Financial Times* published an investigation reporting that regulatory intelligence firm RegLayer documented at least 47 major US data center projects that were delayed, withdrawn, or blocked by local opposition/zoning restrictions in 2026"
      },
      "groundingChunkIndices": [
        6
      ]
    },
    {
      "segment": {
        "startIndex": 1418,
        "endIndex": 1601,
        "text": "It also highlighted recent research from Bernstein analysts estimating that only ~35% of the currently planned US data center capacity pipeline is credible and deliverable on schedule"
      },
      "groundingChunkIndices": [
        7,
        6
      ]
    },
    {
      "segment": {
        "startIndex": 1605,
        "endIndex": 1739,
        "text": "**Important caveats:** RegLayer’s figure of 47 sites represents a conservative estimate focused strictly on large-scale developments"
      },
      "groundingChunkIndices": [
