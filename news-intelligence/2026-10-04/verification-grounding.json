      ]
    },
    {
      "segment": {
        "startIndex": 1419,
        "endIndex": 1700,
        "text": "#### [6] Google Defends £1.2B UK Consumer Class Action Lawsuit Over Play Store Fees\n* **What is confirmed:** Google is set to defend a £1.2 billion opt-out class action lawsuit brought on behalf of approximately 20 million UK consumers in the UK Competition Appeal Tribunal (CAT)"
      },
      "groundingChunkIndices": [
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1702,
        "endIndex": 1936,
        "text": "The suit, led by consumer advocate Liz Coll, alleges Google abused its dominant market position by charging excessive 30% commissions on Play Store purchases since October 2015, which were passed on to consumers as inflated app prices"
      },
      "groundingChunkIndices": [
        5,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 2069,
        "endIndex": 2131,
        "text": "Barry Rodger) that received CAT approval in mid-September 2026"
      },
      "groundingChunkIndices": [
        6,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 2133,
        "endIndex": 2190,
        "text": "Google continues to deny liability in the consumer action"
      },
      "groundingChunkIndices": [
        4,
        7
