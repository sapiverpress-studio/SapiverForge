  "groundingSupports": [
    {
      "segment": {
        "startIndex": 630,
        "endIndex": 665,
        "text": "**What is confirmed:** The Guardian"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 630,
        "endIndex": 823,
        "text": "**What is confirmed:** The Guardian reported on Nov 20, 2026, that the Nasdaq Composite erased all of its 2026 gains (closing down ~5% YTD) following a widespread sell-off in AI-linked equities"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 825,
        "endIndex": 923,
        "text": "The drop coincided with Anthropic’s second day of trading following its historic $81B+ IPO debut"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 925,
        "endIndex": 1024,
        "text": "Anthropic shares (ticker: `ANT`) dropped over 9% on Friday to $88.17, nearing their $83 offer price"
      },
      "groundingChunkIndices": [
        2
      ]
    },
    {
      "segment": {
        "startIndex": 1028,
        "endIndex": 1238,
        "text": "**Important caveats:** The stock slump reflects macro-level investor anxiety regarding massive corporate AI capital expenditures and data center commitments rather than internal operational failure at Anthropic"
      },
      "groundingChunkIndices": [
        0,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 1242,
        "endIndex": 1344,
        "text": "**Suitable for publication today:** **YES** — Lead story for market and business technology coverage"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 1444,
        "endIndex": 1496,
        "text": "**What is confirmed:** Nikkei Asia (Cheng Ting-Fang)"
      },
      "groundingChunkIndices": [
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1444,
        "endIndex": 1634,
        "text": "**What is confirmed:** Nikkei Asia (Cheng Ting-Fang) reported on Nov 20–21, 2026, that tighter U.S. export rules introduced this week are causing unexpected, broad supply-chain disruptions"
      },
      "groundingChunkIndices": [
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1636,
        "endIndex": 1753,
