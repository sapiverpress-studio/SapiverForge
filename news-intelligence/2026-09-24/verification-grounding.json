      ]
    },
    {
      "segment": {
        "startIndex": 4850,
        "endIndex": 5170,
        "text": "#### **[13] Meta: Visual data opt-out for smart glasses AI training**\n* **Confirmed:** Meta introduced a new privacy control allowing smart glasses users to opt out of having \"visual data\" (images/videos captured during Meta AI queries) used to train AI models or reviewed by third-party human contractors outside the US"
      },
      "groundingChunkIndices": [
