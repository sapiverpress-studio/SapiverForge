  "groundingSupports": [
    {
      "segment": {
        "startIndex": 804,
        "endIndex": 866,
        "text": "**Publisher / Origin:** *Politico* (Joseph Bambridge) / UK CMA"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 869,
        "endIndex": 987,
        "text": "**What is confirmed:** Meta launched its \"Muse\" personal AI assistant in the UK across iOS, Android, web, and WhatsApp"
      },
      "groundingChunkIndices": [
        1
      ]
    },
    {
      "segment": {
        "startIndex": 989,
        "endIndex": 1289,
        "text": "Following advance engagement with the UK Competition and Markets Authority (CMA) and the Information Commissioner's Office (ICO) regarding data protection and consumer laws, Meta updated its UK terms of service to afford UK users significantly stronger consumer protection rights than users in the US"
      },
      "groundingChunkIndices": [
        2,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 1294,
        "endIndex": 1541,
        "text": "**Important caveats:** The CMA and ICO emphasized that they are continuing to closely monitor Muse’s rollout under a voluntary reporting scheme, particularly regarding automated actions taken on behalf of users (e.g., retail and travel bookings)"
      },
      "groundingChunkIndices": [
        2,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1755,
        "endIndex": 1832,
        "text": "**Publisher / Origin:** *The New York Times* (Keith Bradsher, Adam Satariano)"
      },
      "groundingChunkIndices": [
        5,
        6
      ]
    },
    {
      "segment": {
