  "groundingSupports": [
    {
      "segment": {
        "startIndex": 298,
        "endIndex": 461,
        "text": "**Outdated / Stale Candidates:** Candidates **[16]**, **[17]**, and **[19]** are archived Reuters reports from June 2026 and are not suitable for publication today"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 848,
        "endIndex": 998,
        "text": "Mathew of New Mexico’s First Judicial District Court ordered Meta Platforms to pay $25 billion in civil penalties following a September jury verdict"
      },
      "groundingChunkIndices": [
        1,
        2
      ]
    },
    {
      "segment": {
        "startIndex": 1000,
        "endIndex": 1175,
        "text": "The jury found nearly 44 million willful violations of New Mexico's Unfair Practices Act regarding Facebook’s handling of user privacy during the Cambridge Analytica scandal"
      },
      "groundingChunkIndices": [
        3,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1177,
        "endIndex": 1368,
        "text": "Statutory penalties under state law totaled over $219 billion before the judge reduced the award to $25 billion, making it the largest commercial judgment against a tech company in US history"
      },
      "groundingChunkIndices": [
        1,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1429,
