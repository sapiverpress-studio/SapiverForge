  "groundingSupports": [
    {
      "segment": {
        "startIndex": 216,
        "endIndex": 370,
        "text": "**What is confirmed:** OpenAI executive Thibault Sottiaux confirmed on X that OpenAI corrected a launch billing error for its GPT-6.2 Astra and Sol models"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 372,
        "endIndex": 420,
        "text": "The error had incorrectly discounted model usage"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 422,
        "endIndex": 599,
        "text": "Following the fix, paying users across ChatGPT Work, Codex, Plus, Pro, and Business plans will reach usage caps 40% faster on Astra and 25% faster on Sol compared to launch week"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
