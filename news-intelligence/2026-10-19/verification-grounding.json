  "groundingSupports": [
    {
      "segment": {
        "startIndex": 196,
        "endIndex": 352,
        "text": "**Confirmed:** Research paper published on arXiv (`arXiv:2610.18861`, submitted October 13, 2026) by authors from Stanford University, Together AI, and UIUC"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 354,
        "endIndex": 578,
        "text": "The authors introduce \"HybridAgent\", an architecture using a lightweight \"HybridLink\" and continuous working memory that allows LLM agents to dynamically switch between latent-space reasoning and text-based tool interactions"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 580,
        "endIndex": 708,
        "text": "Benchmarks report a 10.4% performance boost across 11 tasks alongside 35–55% token reductions and 1.8x–2.6x faster inference"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 712,
        "endIndex": 873,
        "text": "**Important Caveats:** Claims of efficiency and performance gains are self-reported research benchmarks; the paper is pre-print and has not undergone peer review"
