  "groundingSupports": [
    {
      "segment": {
        "startIndex": 134,
        "endIndex": 443,
        "text": "### **[15] Anthropic and OpenAI push for control over third-party AI safety evaluations**\n* **Publisher:** Reuters (Aditya Soni)\n* **Confirmed:** Reuters reported that Anthropic and OpenAI have sought contract terms giving them significant approval rights over what external AI evaluators can publicly publish"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 445,
        "endIndex": 609,
        "text": "The companies cite concerns that embedded evaluators with deep internal access could inadvertently disclose trade secrets or proprietary architecture to competitors"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 611,
        "endIndex": 742,
        "text": "* **Important Caveats:** Both labs recently made public commitments endorsing independent evaluation without editorial interference"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 744,
        "endIndex": 1027,
        "text": "Anthropic told Reuters that pre-publication approval rights apply specifically to new evaluator firms while establishing working relationships, whereas OpenAI stated it only redacts strictly confidential details and permits evaluators to explicitly flag when redactions have occurred"
      },
      "groundingChunkIndices": [
        2,
        3
      ]
    },
    {
      "segment": {
