  "groundingSupports": [
    {
      "segment": {
        "startIndex": 1042,
        "endIndex": 1208,
        "text": "**What is confirmed:** Former xAI founding members Guodong Zhang, Zihang Dai, and Manuel Kroiss have launched a new artificial intelligence startup called **Epochal**"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 1210,
        "endIndex": 1365,
        "text": "The startup is developing AI agents designed for high-accuracy event prediction, utilizing a historical internet archive (\"time portal\") for model training"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 1370,
        "endIndex": 1482,
        "text": "**Important caveats:** Bloomberg reports that co-founder Guodong Zhang personally committed $100M to the company"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 1484,
        "endIndex": 1621,
        "text": "However, the financing details cite an anonymous source familiar with the matter, as Epochal declined official comment on capital figures"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 1663,
        "endIndex": 1714,
        "text": "Strong candidate for AI market and startup coverage"
      },
      "groundingChunkIndices": [
        1
      ]
    },
    {
      "segment": {
        "startIndex": 1789,
        "endIndex": 2020,
        "text": "**What is confirmed:** NVIDIA's Board of Directors announced on Nov 23, 2026, that Jensen Huang has been unanimously reinstated as President, CEO, and Board Director, ending his brief removal following an internal governance review"
      },
      "groundingChunkIndices": [
        2,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 2022,
        "endIndex": 2149,
        "text": "The board stated it consulted senior U.S. government officials and determined his reinstatement poses no national security risk"
      },
      "groundingChunkIndices": [
        2,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 2151,
        "endIndex": 2203,
        "text": "Interim CEO Colette Kress returns to her role as CFO"
      },
      "groundingChunkIndices": [
        2
      ]
    },
    {
      "segment": {
        "startIndex": 2207,
        "endIndex": 2325,
        "text": "**Important caveats:** Huang's return follows a turbulent period of board investigation and intense political lobbying"
      },
      "groundingChunkIndices": [
        5,
        6
      ]
    },
    {
      "segment": {
