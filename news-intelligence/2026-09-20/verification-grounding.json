        20
      ]
    },
    {
      "segment": {
        "startIndex": 3881,
        "endIndex": 4265,
        "text": "#### **Candidate [4]: Clinicians Voice Caution Over Expanding Medical AI Beyond Diagnostics**\n* **Publisher:** Financial Times (Sarah Neville)\n* **What is confirmed:** The Financial Times reports that medical practitioners and health leaders are expressing strong skepticism regarding the expansion of AI into clinical decision-making beyond established diagnostic and imaging domains"
      },
      "groundingChunkIndices": [
        19,
        21
      ]
    },
    {
      "segment": {
        "startIndex": 4267,
        "endIndex": 4482,
        "text": "Clinicians cite a lack of real-world clinical performance data, pointing to issues such as risk of deskilling, model hallucinations, and low institutional governance awareness highlighted in recent physician surveys"
      },
      "groundingChunkIndices": [
