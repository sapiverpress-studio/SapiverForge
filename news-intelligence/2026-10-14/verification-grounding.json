      "segment": {
        "startIndex": 1447,
        "endIndex": 1569,
        "text": "* **Important caveats:** The $250M commitment consists of compute allocations/cloud credits rather than direct cash grants"
      },
      "groundingChunkIndices": [
        0,
        1
      ]
    },
    {
      "segment": {
        "startIndex": 1608,
