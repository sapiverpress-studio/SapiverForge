  "groundingSupports": [
    {
      "segment": {
        "startIndex": 777,
        "endIndex": 929,
        "text": "**What is confirmed:** Anthropic published a technical post detailing the full migration of its primary Messages API routing service from Python to Rust"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 931,
        "endIndex": 1060,
        "text": "Anthropic confirmed that a team with zero initial Rust experience used Claude Code to generate the vast majority of the Rust code"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 931,
        "endIndex": 1165,
        "text": "Anthropic confirmed that a team with zero initial Rust experience used Claude Code to generate the vast majority of the Rust code, verifying output equivalence by routing shadow production traffic through both Python and Rust services"
      },
      "groundingChunkIndices": [
        1,
        0
      ]
    },
    {
      "segment": {
        "startIndex": 1167,
        "endIndex": 1288,
        "text": "The migration yielded a 40%–50% reduction in CPU consumption and a 10%–20% improvement in time-to-first-token latency"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 1292,
        "endIndex": 1441,
        "text": "**Important caveats:** The performance improvements apply to the API proxy/routing layer, not to the underlying neural network token generation speed"
      },
      "groundingChunkIndices": [
        1
      ]
    },
    {
      "segment": {
        "startIndex": 1558,
        "endIndex": 1720,
        "text": "**What is confirmed:** Google Research uploaded a suite of theoretical mathematics preprints to its GitHub repository (`google-research/cogentic_research_papers`)"
      },
      "groundingChunkIndices": [
        2,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 1722,
        "endIndex": 1827,
        "text": "The papers were produced by \"Cogentic,\" Google’s multi-agent AI framework for automated proof discovery"
      },
      "groundingChunkIndices": [
        3,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1829,
        "endIndex": 1924,
        "text": "The lead paper claims an unconditional time bound of $L_N[1/3, O(1)]$ for integer factorization"
      },
      "groundingChunkIndices": [
        2,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 1928,
        "endIndex": 2031,
        "text": "**Important caveats:** The repository explicitly notes these preprints are not official Google products"
      },
      "groundingChunkIndices": [
        3
      ]
