        "startIndex": 8259,
        "endIndex": 8313,
        "text": "Core services were restored over the preceding weekend"
      },
      "groundingChunkIndices": [
        30,
        31
      ]
    },
    {
      "segment": {
        "startIndex": 8529,
        "endIndex": 8744,
        "text": "**What is confirmed:** Oakland-based Numa announced a $45 million Series C funding round led by Blue Cloud Ventures, with participation from Threshold Ventures, Costanoa Ventures, Gradient Ventures, and Tokio Marine"
      },
      "groundingChunkIndices": [
        32,
