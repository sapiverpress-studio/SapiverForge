  "groundingSupports": [
    {
      "segment": {
        "startIndex": 668,
        "endIndex": 1009,
        "text": "**What is confirmed:** On October 26, 2026, OpenAI published a blog post and preprints on GitHub claiming three AI-generated breakthroughs from an unreleased internal model across theoretical computer science (a disproof of the Exponential Time Hypothesis), harmonic analysis (local smoothing for the wave equation), and quantum field theory"
      },
      "groundingChunkIndices": [
        0,
        1,
        2
      ]
    },
    {
      "segment": {
        "startIndex": 1011,
        "endIndex": 1141,
        "text": "The company outlined a new \"shepherding\" model engaging academic external groups to review and explain the AI-generated raw output"
      },
      "groundingChunkIndices": [
        1,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 1145,
        "endIndex": 1237,
        "text": "**Important caveats:** These are unrefereed vendor claims produced by an unreleased AI model"
      },
      "groundingChunkIndices": [
        0,
        4
      ]
    },
