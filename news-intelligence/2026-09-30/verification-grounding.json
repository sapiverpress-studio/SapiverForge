  "groundingSupports": [
    {
      "segment": {
        "startIndex": 112,
        "endIndex": 346,
        "text": "### **Candidate [0]: OpenAI Releases GPT-6.1 Sol**\n* **Publisher / Source:** `openai.com`\n* **Editorial Scope:** IN SCOPE (AI / Frontier Models)\n* **What is confirmed:** OpenAI officially launched **GPT-6.1 Sol** on September 29, 2026"
      },
      "groundingChunkIndices": [
        0
      ]
    },
    {
      "segment": {
        "startIndex": 348,
        "endIndex": 568,
        "text": "The model delivers agentic coding, computer navigation, and complex reasoning capabilities close to flagship model GPT-6 Astra at one-fifth of Astra’s standard API token cost ($2.00 input / $10.00 output per 1M tokens)"
      },
      "groundingChunkIndices": [
        1,
        2,
        3
      ]
    },
    {
      "segment": {
        "startIndex": 570,
        "endIndex": 675,
        "text": "It features a 1M token context window and is available via ChatGPT, the OpenAI API, and Microsoft Foundry"
      },
      "groundingChunkIndices": [
        2,
        4
      ]
    },
    {
      "segment": {
        "startIndex": 677,
        "endIndex": 807,
        "text": "OpenAI simultaneously introduced an \"Ultrafast\" inference tier offering generation speeds up to 300 tokens/sec for frontier models"
      },
      "groundingChunkIndices": [
        3
      ]
    },
