      ]
    },
    {
      "segment": {
        "startIndex": 8746,
        "endIndex": 8887,
        "text": "Numa provides AI agents that connect to car dealership software to automate customer communications, service bookings, and warranty paperwork"
      },
      "groundingChunkIndices": [
        32,
        33
      ]
    },
    {
      "segment": {
        "startIndex": 8891,
        "endIndex": 9081,
        "text": "**Important caveats:** The reported $500 million post-money valuation comes from a source familiar with the deal cited in press coverage, rather than explicit line items in the press release"
      },
      "groundingChunkIndices": [
        32,
        33
      ]
    },
    {
      "segment": {
        "startIndex": 9269,
        "endIndex": 9420,
        "text": "**What is confirmed:** Meta confirmed it is testing \"Direct,\" a standalone messaging app built on Instagram's DM infrastructure, in Thailand and Turkey"
      },
      "groundingChunkIndices": [
        34,
        35
      ]
    },
    {
      "segment": {
        "startIndex": 9422,
        "endIndex": 9560,
        "text": "Unlike previous iterations, users can sign up for Direct using a phone number or email address without needing an active Instagram account"
      },
      "groundingChunkIndices": [
        34,
        35
      ]
    },
    {
      "segment": {
        "startIndex": 9564,
        "endIndex": 9674,
        "text": "**Important caveats:** Meta previously tested a standalone app called \"Direct\" in 2017 before shutting it down"
      },
      "groundingChunkIndices": [
        34
      ]
    },
    {
      "segment": {
        "startIndex": 9676,
        "endIndex": 9773,
        "text": "The current trial is limited geographically, and Meta has not announced a global rollout timeline"
      },
      "groundingChunkIndices": [
        35
      ]
    },
    {
      "segment": {
        "startIndex": 9970,
        "endIndex": 10129,
        "text": "**What is confirmed:** An investigation published by ModelRepublic (Philip Dowdell) analyzed ~1,400 influencer campaigns tracked on the \"Urban Legend\" platform"
      },
      "groundingChunkIndices": [
        36,
        37
      ]
    },
    {
      "segment": {
        "startIndex": 10131,
        "endIndex": 10313,
        "text": "Findings show paid creators posted tracked links advocating pro-AI state legislation, US crypto policy (the CLARITY Act), and messaging advocating for Nvidia H200 chip sales to China"
      },
      "groundingChunkIndices": [
