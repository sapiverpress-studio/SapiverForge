    },
    {
      "segment": {
        "startIndex": 1247,
        "endIndex": 1361,
        "text": "GPT-6 Sol is deployed for Plus, Pro, Business, and Enterprise plans, while GPT-6 Luna powers the Free and Go tiers"
      },
      "groundingChunkIndices": [
        6,
